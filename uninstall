#!/usr/bin/env bash
# Remove Omarchy GTK4 Theming. GTK 4 apps go back to stock Adwaita colours the
# next time they start.
set -euo pipefail

LIB="$HOME/.local/lib/gtk-live-css.so"
TPL="$HOME/.config/omarchy/themed/gtk.css.tpl"
GTK_CSS="$HOME/.config/gtk-4.0/gtk.css"
THEME_CSS="$HOME/.local/state/omarchy/current/theme/gtk.css"
BINDINGS="$HOME/.config/hypr/bindings.lua"

# Only remove files we wrote, never a user's own override of the same name.
{ grep -ls gtk-live-css "$HOME"/.local/share/dbus-1/services/*.service \
  "$HOME"/.local/share/applications/*.desktop || true; } | xargs -r -d "\n" rm -f
busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 || true

if [[ -f $BINDINGS ]]; then
  sed -i '/^-- >>> omarchy-gtk4-theming >>>$/,/^-- <<< omarchy-gtk4-theming <<<$/d' "$BINDINGS"
  hyprctl reload >/dev/null 2>&1 || true
fi

[[ $(readlink "$GTK_CSS" 2>/dev/null) == "$THEME_CSS" ]] && rm -f "$GTK_CSS"
rm -f "$TPL" "$THEME_CSS" "$LIB" "$HOME/.config/omarchy/hooks/theme-set.d/gtk4-theming.sh"

for t in Adwaita Adwaita-dark Omarchy-GTK Omarchy-GTK-dark; do
  grep -qs gtk-live-css "$HOME/.local/share/themes/$t/gtk-3.0/gtk.css" && rm -rf "$HOME/.local/share/themes/$t"
done
# Hand the GTK theme back to Omarchy (Adwaita / Adwaita-dark by theme mode).
omarchy-theme-set-gnome 2>/dev/null || true

printf 'Omarchy GTK4 Theming removed. Restart open GTK 4 apps (e.g. nautilus -q) to drop the live reload.\n'
