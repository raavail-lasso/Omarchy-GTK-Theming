#!/usr/bin/env bash
# Install Omarchy GTK4 Theming for the current user. Safe to re-run; re-run it
# after an app update to refresh the override files.
set -euo pipefail

# GTK 4 apps that repaint live on theme switch, by .desktop file name (without
# .desktop). Add one, re-run ./install, restart the app. Only apps compiled
# against GTK 4 work; Python/JS apps load GTK too late for the library.
APPS=(
  org.gnome.Nautilus
  org.gnome.Papers
  transmission-gtk
  dev.tensaku.Tensaku
)

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$HOME/.local/lib/gtk-live-css.so"
TPL="$HOME/.config/omarchy/themed/gtk.css.tpl"
GTK_CSS="$HOME/.config/gtk-4.0/gtk.css"
THEME_CSS="$HOME/.local/state/omarchy/current/theme/gtk.css"
THEMES_DIR="$HOME/.local/share/themes"
HOOK="$HOME/.config/omarchy/hooks/theme-set.d/gtk4-theming.sh"
DBUS_DIR="$HOME/.local/share/dbus-1/services"
DESKTOP_DIR="$HOME/.local/share/applications"
BINDINGS="$HOME/.config/hypr/bindings.lua"
BEGIN="-- >>> omarchy-gtk4-theming >>>"
END="-- <<< omarchy-gtk4-theming <<<"
NOTE="Omarchy GTK4 Theming (gtk-live-css). Remove with $SRC/uninstall"

step() { printf '  %s\n' "$*"; }

printf '\nInstalling Omarchy GTK4 Theming\n\n'

# --- dependencies -----------------------------------------------------------
command -v gcc >/dev/null && pkg-config --exists gtk4 || {
  printf 'Need gcc and the gtk4 headers.  On Arch:  sudo pacman -S gcc pkgconf gtk4\n' >&2
  exit 1
}
command -v omarchy-theme-set-templates >/dev/null || { printf 'Omarchy not found.\n' >&2; exit 1; }
[[ -d /usr/share/themes/adw-gtk3-dark ]] || {
  printf 'Need adw-gtk3 for GTK 3 and non-libadwaita apps.  On Arch:  sudo pacman -S adw-gtk-theme\n' >&2
  exit 1
}
step "dependencies present"

# --- theme colours -> gtk.css -----------------------------------------------
install -Dm644 "$SRC/themed/gtk.css.tpl" "$TPL"
step "installed template -> $TPL"

mkdir -p "$(dirname "$GTK_CSS")"
if [[ -e $GTK_CSS && ! -L $GTK_CSS ]]; then
  mv "$GTK_CSS" "$GTK_CSS.bak.$(date +%s)"
  step "backed up your existing gtk.css"
fi
ln -sfn "$THEME_CSS" "$GTK_CSS"
step "linked $GTK_CSS -> current theme"

# GTK 3 apps, and GTK 4 apps that don't use libadwaita's styles (Transmission),
# ignore those colour names under GTK's built-in theme, which hard-codes its
# colours. adw-gtk3 looks them up by name like libadwaita does, so a theme that
# imports adw-gtk3 and then our colours covers them. libadwaita apps ignore GTK
# themes, so this can't affect them.
for variant in Omarchy-GTK:adw-gtk3 Omarchy-GTK-dark:adw-gtk3-dark; do
  name=${variant%%:*} base=${variant#*:}
  # In dark mode GTK loads gtk-dark.css and, if it's missing, silently falls
  # back to its built-in theme, so both files are needed.
  for gtk in gtk-3.0 gtk-4.0; do
    mkdir -p "$THEMES_DIR/$name/$gtk"
    for css in gtk.css gtk-dark.css; do
      cat > "$THEMES_DIR/$name/$gtk/$css" <<EOF
/* $NOTE */
@import url("file:///usr/share/themes/$base/$gtk/$css");
@import url("file://$THEME_CSS");
EOF
      # adw-gtk3's GTK 4 tweaks pin the accent to blue; follow the theme's instead.
      [[ $gtk == gtk-4.0 ]] && echo ':root { --accent-bg-color: @accent_bg_color; }' >> "$THEMES_DIR/$name/$gtk/$css"
    done
  done
done
step "created GTK themes Omarchy-GTK and Omarchy-GTK-dark (adw-gtk3 + theme colours)"

install -Dm755 "$SRC/hooks/gtk4-theming.sh" "$HOOK"
step "installed theme-set hook -> $HOOK"

# --- live reload library ----------------------------------------------------
# Build to a temp file and move it in: a running Nautilus keeps the old copy.
mkdir -p "$(dirname "$LIB")"
gcc -shared -fPIC -O2 -Wall -Wl,-z,defs $(pkg-config --cflags gtk4) \
  -o "$LIB.tmp" "$SRC/src/gtk-live-css.c" -ldl
mv "$LIB.tmp" "$LIB"
step "built $LIB"

# --- load it into the apps --------------------------------------------------
# Each app gets a copy of its .desktop file (app launcher, file associations)
# and, if it has one, its D-Bus service file ("Show in folder", launchers that
# honour DBusActivatable), with LD_PRELOAD put in front of every Exec= line.
mkdir -p "$DBUS_DIR" "$DESKTOP_DIR"

# Drop last run's overrides first, so apps removed from APPS are cleaned up.
{ grep -ls gtk-live-css "$DBUS_DIR"/*.service "$DESKTOP_DIR"/*.desktop || true; } | xargs -r -d "\n" rm -f

# override <system file> <user file> <Exec prefix>
override() {
  [[ -f $1 ]] || return 0
  if [[ -e $2 ]]; then
    step "WARNING: skipped $(basename "$2"), you already have your own override"
    return 1
  fi
  { echo "# $NOTE"; sed "s|^Exec=|Exec=$3 |" "$1"; } > "$2"
}

for app in "${APPS[@]}"; do
  if [[ ! -f /usr/share/applications/$app.desktop ]]; then
    step "WARNING: $app.desktop not found, skipped"
    continue
  fi
  override "/usr/share/applications/$app.desktop" "$DESKTOP_DIR/$app.desktop" "env LD_PRELOAD=$LIB" || continue
  override "/usr/share/dbus-1/services/$app.service" "$DBUS_DIR/$app.service" "/usr/bin/env LD_PRELOAD=$LIB" || true
  step "live reload enabled for $app"
done

busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 || true
update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true

# Omarchy's Super+Shift+F starts nautilus by name, skipping both files above.
if [[ -f $BINDINGS ]]; then
  sed -i "/^$BEGIN\$/,/^$END\$/d" "$BINDINGS"
  cat >> "$BINDINGS" <<EOF
$BEGIN
-- $NOTE
hl.unbind("SUPER + SHIFT + F")
o.bind("SUPER + SHIFT + F", "File manager", "env LD_PRELOAD=$LIB omarchy-launch-nautilus")
hl.unbind("SUPER + ALT + SHIFT + F")
o.bind("SUPER + ALT + SHIFT + F", "File manager (cwd)", "env LD_PRELOAD=$LIB omarchy-launch-nautilus-cwd")
$END
EOF
  hyprctl reload >/dev/null 2>&1 || true
  step "rebound Super+Shift+F / Super+Alt+Shift+F in $BINDINGS"
fi

# --- render for the current theme -------------------------------------------
if [[ ! -f $THEME_CSS ]]; then
  omarchy-theme-refresh >/dev/null 2>&1 || true
  step "rendered gtk.css for the current theme"
fi
bash "$HOOK"
step "switched GTK theme to $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null)"

cat <<'DONE'

Done. Restart open GTK apps once so they pick everything up, e.g.:
  nautilus -q        then open it with Super+Shift+F

Check it loaded (should print a number above 0):
  grep -c gtk-live-css /proc/$(pgrep -x nautilus)/maps
DONE
