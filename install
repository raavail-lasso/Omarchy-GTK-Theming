#!/usr/bin/env bash
# Install Omarchy GTK Theming for the current user. Safe to re-run; re-run it
# after an app update to refresh the override files.
set -euo pipefail

# GTK 4 apps that repaint live on theme switch, by .desktop file name (without
# .desktop). Add one, re-run ./install, restart the app. Only apps compiled
# against GTK 4 work; Python/JS apps load GTK too late for the library.
APPS=(
  org.gnome.Nautilus
  org.gnome.Papers
  transmission-gtk
  dev.tensaku.Tensaku
)

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$HOME/.local/lib/gtk-live-css.so"
TPL="$HOME/.config/omarchy/themed/gtk.css.tpl"
TPL3="$HOME/.config/omarchy/themed/gtk3.css.tpl"
GTK_CSS="$HOME/.config/gtk-4.0/gtk.css"
GTK3_CSS="$HOME/.config/gtk-3.0/gtk.css"
THEME_CSS3="$HOME/.local/state/omarchy/current/theme/gtk3.css"
DATA="$HOME/.local/share/omarchy-gtk-theming"
THEME_CSS="$HOME/.local/state/omarchy/current/theme/gtk.css"
THEMES_DIR="$HOME/.local/share/themes"
OLD_HOOK="$HOME/.config/omarchy/hooks/theme-set.d/gtk4-theming.sh"
DBUS_DIR="$HOME/.local/share/dbus-1/services"
DESKTOP_DIR="$HOME/.local/share/applications"
BINDINGS="$HOME/.config/hypr/bindings.lua"
BEGIN="-- >>> omarchy-gtk-theming >>>"
END="-- <<< omarchy-gtk-theming <<<"
NOTE="Omarchy GTK Theming (gtk-live-css). Remove with $SRC/uninstall"

step() { printf '  %s\n' "$*"; }

printf '\nInstalling Omarchy GTK Theming\n\n'

# --- dependencies -----------------------------------------------------------
command -v gcc >/dev/null && pkg-config --exists gtk4 || {
  printf 'Need gcc and the gtk4 headers.  On Arch:  sudo pacman -S gcc pkgconf gtk4\n' >&2
  exit 1
}
command -v omarchy-theme-set-templates >/dev/null || { printf 'Omarchy not found.\n' >&2; exit 1; }
[[ -d /usr/share/themes/adw-gtk3-dark ]] || {
  printf 'Need adw-gtk3 for GTK 3 and non-libadwaita apps.  On Arch:  sudo pacman -S adw-gtk-theme\n' >&2
  exit 1
}
step "dependencies present"

# --- theme colours -> gtk.css -----------------------------------------------
install -Dm644 "$SRC/themed/gtk.css.tpl" "$TPL"
step "installed template -> $TPL"

mkdir -p "$(dirname "$GTK_CSS")"
if [[ -e $GTK_CSS && ! -L $GTK_CSS ]]; then
  mv "$GTK_CSS" "$GTK_CSS.bak.$(date +%s)"
  step "backed up your existing gtk.css"
fi
ln -sfn "$THEME_CSS" "$GTK_CSS"
step "linked $GTK_CSS -> current theme"

# GTK 3 apps and GTK 4 apps that don't use libadwaita's styles (Transmission)
# run on GTK's built-in theme, which hard-codes its colours, so colour names do
# nothing there. adw-gtk3 looks them up by name like libadwaita does, so
# importing adw-gtk3 and then our colours covers them.

# GTK 3: a user stylesheet that imports adw-gtk3 (light or dark, by the theme's
# mode) and our colours. GTK 3 loads ~/.config/gtk-3.0/gtk.css above any theme,
# so this holds even for libhandy apps, which switch to GTK's built-in Adwaita.
mkdir -p "$DATA"
for mode in light:adw-gtk3 dark:adw-gtk3-dark; do
  echo "@import url(\"file:///usr/share/themes/${mode#*:}/gtk-3.0/gtk.css\");" > "$DATA/adw-gtk3-${mode%%:*}.css"
done
sed -e "s|@DATA@|$DATA|" -e "s|@THEME_CSS@|$THEME_CSS|" "$SRC/themed/gtk3.css.tpl" > "$TPL3"
mkdir -p "$(dirname "$GTK3_CSS")"
if [[ -e $GTK3_CSS && ! -L $GTK3_CSS ]]; then
  mv "$GTK3_CSS" "$GTK3_CSS.bak.$(date +%s)"
  step "backed up your existing GTK 3 gtk.css"
fi
ln -sfn "$THEME_CSS3" "$GTK3_CSS"
step "linked $GTK3_CSS -> current theme (adw-gtk3 + theme colours)"

# GTK 4: themes named Adwaita and Adwaita-dark. GTK 4 finds these in
# ~/.local/share/themes before its built-in copies, so Omarchy's own reset on
# every switch (omarchy-theme-set-gnome) picks them. No hook to wait for, so no
# window where apps fall back to the built-in theme. libadwaita apps ignore GTK
# themes, so this can't affect them.
for variant in Adwaita:adw-gtk3 Adwaita-dark:adw-gtk3-dark; do
  name=${variant%%:*} base=${variant#*:}
  if [[ -e $THEMES_DIR/$name ]] && ! grep -qs gtk-live-css "$THEMES_DIR/$name/gtk-4.0/gtk.css"; then
    step "WARNING: skipped $THEMES_DIR/$name, you already have your own theme there"
    continue
  fi
  # In dark mode GTK loads gtk-dark.css and, if it's missing, silently falls
  # back to its built-in theme, so both files are needed.
  mkdir -p "$THEMES_DIR/$name/gtk-4.0"
  rm -rf "${THEMES_DIR:?}/$name/gtk-3.0"   # earlier versions also shadowed GTK 3 here
  for css in gtk.css gtk-dark.css; do
    # adw-gtk3's GTK 4 tweaks pin the accent to blue; the last line follows the
    # theme's accent instead.
    cat > "$THEMES_DIR/$name/gtk-4.0/$css" <<EOF
/* $NOTE */
@import url("file:///usr/share/themes/$base/gtk-4.0/$css");
@import url("file://$THEME_CSS");
:root { --accent-bg-color: @accent_bg_color; }
EOF
  done
done
step "created GTK 4 themes Adwaita and Adwaita-dark in $THEMES_DIR (adw-gtk3 + theme colours)"

# Earlier versions used Omarchy-GTK themes plus a theme-set hook, which ran
# after every other hook and left apps on the built-in theme for seconds.
rm -f "$OLD_HOOK"
# ...and before the project was renamed, these names.
[[ -f $BINDINGS ]] && sed -i '/^-- >>> omarchy-gtk4-theming >>>$/,/^-- <<< omarchy-gtk4-theming <<<$/d' "$BINDINGS"
rm -rf "$HOME/.local/share/omarchy-gtk4-theming"
for t in Omarchy-GTK Omarchy-GTK-dark; do
  grep -qs gtk-live-css "$THEMES_DIR/$t/gtk-4.0/gtk.css" && rm -rf "${THEMES_DIR:?}/$t"
done

# --- live reload library ----------------------------------------------------
# Build to a temp file and move it in: a running Nautilus keeps the old copy.
mkdir -p "$(dirname "$LIB")"
gcc -shared -fPIC -O2 -Wall -Wl,-z,defs $(pkg-config --cflags gtk4) \
  -o "$LIB.tmp" "$SRC/src/gtk-live-css.c" -ldl
mv "$LIB.tmp" "$LIB"
step "built $LIB"

# --- load it into the apps --------------------------------------------------
# Each app gets a copy of its .desktop file (app launcher, file associations)
# and, if it has one, its D-Bus service file ("Show in folder", launchers that
# honour DBusActivatable), with LD_PRELOAD put in front of every Exec= line.
mkdir -p "$DBUS_DIR" "$DESKTOP_DIR"

# Drop last run's overrides first, so apps removed from APPS are cleaned up.
{ grep -ls gtk-live-css "$DBUS_DIR"/*.service "$DESKTOP_DIR"/*.desktop || true; } | xargs -r -d "\n" rm -f

# override <system file> <user file> <Exec prefix>
override() {
  [[ -f $1 ]] || return 0
  if [[ -e $2 ]]; then
    step "WARNING: skipped $(basename "$2"), you already have your own override"
    return 1
  fi
  { echo "# $NOTE"; sed "s|^Exec=|Exec=$3 |" "$1"; } > "$2"
}

for app in "${APPS[@]}"; do
  if [[ ! -f /usr/share/applications/$app.desktop ]]; then
    step "WARNING: $app.desktop not found, skipped"
    continue
  fi
  override "/usr/share/applications/$app.desktop" "$DESKTOP_DIR/$app.desktop" "env LD_PRELOAD=$LIB" || continue
  override "/usr/share/dbus-1/services/$app.service" "$DBUS_DIR/$app.service" "/usr/bin/env LD_PRELOAD=$LIB" || true
  step "live reload enabled for $app"
done

busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 || true
update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true

# Omarchy's Super+Shift+F starts nautilus by name, skipping both files above.
if [[ -f $BINDINGS ]]; then
  sed -i "/^$BEGIN\$/,/^$END\$/d" "$BINDINGS"
  cat >> "$BINDINGS" <<EOF
$BEGIN
-- $NOTE
hl.unbind("SUPER + SHIFT + F")
o.bind("SUPER + SHIFT + F", "File manager", "env LD_PRELOAD=$LIB omarchy-launch-nautilus")
hl.unbind("SUPER + ALT + SHIFT + F")
o.bind("SUPER + ALT + SHIFT + F", "File manager (cwd)", "env LD_PRELOAD=$LIB omarchy-launch-nautilus-cwd")
$END
EOF
  hyprctl reload >/dev/null 2>&1 || true
  step "rebound Super+Shift+F / Super+Alt+Shift+F in $BINDINGS"
fi

# --- render for the current theme -------------------------------------------
if [[ ! -f $THEME_CSS ]]; then
  omarchy-theme-refresh >/dev/null 2>&1 || true
  step "rendered gtk.css for the current theme"
fi
# gtk3.css only depends on the theme's mode, so render it here too: keeps the
# current theme in step with the template without a full theme refresh.
mode=$(omarchy-theme-color --file "$(dirname "$THEME_CSS")/colors.toml" mode)
sed "s/{{ mode }}/$mode/" "$TPL3" > "$THEME_CSS3"
step "rendered gtk3.css for the current theme ($mode)"
# Let Omarchy set the GTK theme name (Adwaita / Adwaita-dark by theme mode),
# which now resolves to ours.
omarchy-theme-set-gnome 2>/dev/null || true
step "GTK theme is $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null), now adw-gtk3 + theme colours"

cat <<'DONE'

Done. Restart open GTK apps once so they pick everything up, e.g.:
  nautilus -q        then open it with Super+Shift+F

Check it loaded (should print a number above 0):
  grep -c gtk-live-css /proc/$(pgrep -x nautilus)/maps
DONE
